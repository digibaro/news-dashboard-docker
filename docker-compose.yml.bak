# Template. Copy it once and adapt the copy:
#   cp docker-compose.yml.default docker-compose.yml
# docker-compose.yml is not tracked by git, so `git pull` never overwrites your changes.
# Start with:  docker compose up -d --build
# The container filesystem is read-only and nothing is written at runtime (no volumes needed).
services:
  nieuwsdashboard:
    build:
      context: .                  # the version comes from the VERSION file in the repository
    image: nieuwsdashboard:latest
    container_name: nieuwsdashboard
    restart: unless-stopped
    ports:
      # Behind nginx/Apache on the same host (ISPConfig), publish on localhost only:
      #   - "127.0.0.1:8080:8080"
      - "8080:8080"
    read_only: true
    cap_drop: [ALL]
    security_opt:
      - no-new-privileges:true
    mem_limit: 128m
    pids_limit: 64
    # Every variable in .env (next to this file) is passed into the container, so a new key such as
    # NS_API_KEY only needs a line in .env. The lines under environment: below take precedence and
    # add defaults. required: false = no error when there is no .env (Docker Compose 2.24 or newer).
    env_file:
      - path: .env
        required: false
    environment:
      NDB_LISTEN: "0.0.0.0:8080"
      # SANS ISC requires a User-Agent with contact details: set your own site and e-mail.
      NDB_USER_AGENT: "${NDB_USER_AGENT:-Nieuwsdashboard/1.0 (+https://example.nl; contact@example.nl)}"
      ABUSECH_AUTH_KEY: "${ABUSECH_AUTH_KEY:-}"
      NS_API_KEY: "${NS_API_KEY:-}"             # free key from apiportal.ns.nl (Treinstoringen)
      NDB_LOG_LEVEL: "${NDB_LOG_LEVEL:-info}"
      # Requests via a reverse proxy on the host arrive from the Docker gateway (172.16.0.0/12):
      # trust its X-Forwarded-For so rate limits apply per visitor, not to everyone at once.
      NDB_TRUSTED_PROXIES: "${NDB_TRUSTED_PROXIES:-127.0.0.1,::1,172.16.0.0/12}"
      NDB_METRICS: "${NDB_METRICS:-false}"      # true = expose /metrics (Prometheus)
    volumes:
      # create it first:  cp config.yaml.default config.yaml   (not tracked by git)
      - ./config.yaml:/app/config.yaml:ro
    logging:
      driver: json-file
      options: { max-size: "5m", max-file: "2" }
