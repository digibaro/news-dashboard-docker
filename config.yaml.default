  - { id: androidworld,   name: "AndroidWorld",   category: tech, url: "https://androidworld.nl/feed/", homepage: "https://androidworld.nl", lang: nl }
  - { id: androidplanet,  name: "Android Planet", category: tech, url: "https://www.androidplanet.nl/feed/", homepage: "https://www.androidplanet.nl", lang: nl }
  # TODO: techzine.nl returns HTTP 403 (bot protection) for every feed path, also /rss; re-check later.
  - { id: techzine,       name: "Techzine",       category: tech, url: "https://www.techzine.nl/feed/", homepage: "https://www.techzine.nl", lang: nl, enabled: false }
  # Extra security sources (SPEC §8.1): disabled by default. divd verified working 2026-09-24.
  # TODO: the Fraudehelpdesk WordPress feed is reachable but contains no items (checked 2026-09-24).
  - { id: fraudehelpdesk, name: "Fraudehelpdesk", category: tech, url: "https://www.fraudehelpdesk.nl/feed/", homepage: "https://www.fraudehelpdesk.nl", lang: nl, enabled: false }
  # TODO: Digital Trust Center feed parses, but its newest item is from 2025-12-16 (stale).
  - { id: dtc, name: "Digital Trust Center", category: tech, url: "https://www.digitaltrustcenter.nl/rss.xml", homepage: "https://www.digitaltrustcenter.nl", lang: nl, enabled: false }
  - { id: divd, name: "DIVD CSIRT", category: tech, url: "https://csirt.divd.nl/feed.xml", homepage: "https://csirt.divd.nl", lang: en, enabled: false }


  # --- Datalekken (data breaches, incidents and the Dutch DPA) ---
  - { id: databreaches-net, name: "DataBreaches.net", category: datalekken, url: "https://databreaches.net/feed/", homepage: "https://databreaches.net", lang: en }
  - { id: the-record,     name: "The Record",     category: datalekken, url: "https://therecord.media/feed", homepage: "https://therecord.media", lang: en }
  - { id: securityweek,   name: "SecurityWeek",   category: datalekken, url: "https://www.securityweek.com/feed/", homepage: "https://www.securityweek.com", lang: en }
  - { id: thehackernews,  name: "The Hacker News", category: datalekken, url: "https://feeds.feedburner.com/TheHackersNews", homepage: "https://thehackernews.com", lang: en }
  - { id: ap,             name: "Autoriteit Persoonsgegevens", category: datalekken, url: "https://www.autoriteitpersoonsgegevens.nl/rss", homepage: "https://www.autoriteitpersoonsgegevens.nl", lang: nl, interval: 30m, max_age: 1440h }
  # HIBP newly added breaches as news items (off: the Datalekken panel already shows them)
  - { id: hibp, name: "Have I Been Pwned · nieuwe datalekken", category: datalekken, url: "https://feeds.feedburner.com/HaveIBeenPwnedLatestBreaches", homepage: "https://haveibeenpwned.com", lang: en, interval: 1h, enabled: false }

